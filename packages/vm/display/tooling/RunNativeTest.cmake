# Execute each test once, preserving its original child status and QtTest text.
if(NOT DEFINED PROGRAM OR NOT EXISTS "${PROGRAM}")
    message(FATAL_ERROR "Native test executable is missing")
endif()
get_filename_component(test_name "${PROGRAM}" NAME)
set(test_log "${CMAKE_CURRENT_BINARY_DIR}/${test_name}.qtest.txt")
# Only this derived test-owned output is removed, so stale text cannot be read.
file(REMOVE "${test_log}")
execute_process(COMMAND "${PROGRAM}" -o "${test_log},txt" RESULT_VARIABLE child_status)
if(EXISTS "${test_log}")
    file(SIZE "${test_log}" log_size)
    if(log_size GREATER 1048576)
        message(FATAL_ERROR "Native QtTest text exceeds its 1 MiB capacity; child status: ${child_status}")
    endif()
    file(READ "${test_log}" test_text LIMIT 1048576)
    message("${test_text}")
else()
    message("Native test produced no QtTest text file")
endif()
if(NOT child_status STREQUAL "0")
    message(FATAL_ERROR "Native test child exit status: ${child_status}")
endif()
