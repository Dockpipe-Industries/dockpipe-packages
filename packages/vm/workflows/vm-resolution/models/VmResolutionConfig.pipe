/// <summary>Primary Windows guest display geometry. The guest driver must support this mode. Active native views also require at most 4096 pixels per axis and a 32 MiB 32-bit frame.</summary>
public Class VmResolutionConfig
{
    /// <summary>Width in guest pixels. Accepted range: 640 to 8192; the active native display may require a smaller mode.</summary>
    [DisplayName = "Width"]
    [EnvName = "DOCKPIPE_VM_DISPLAY_WIDTH"]
    public string Width = "1920";

    /// <summary>Height in guest pixels. Accepted range: 480 to 8192; the active native display may require a smaller mode.</summary>
    [DisplayName = "Height"]
    [EnvName = "DOCKPIPE_VM_DISPLAY_HEIGHT"]
    public string Height = "1080";

    /// <summary>VM run ID for CLI use. Leave empty when invoked from the VM page.</summary>
    [DisplayName = "VM run ID (CLI only)"]
    [EnvName = "DOCKPIPE_VM_TARGET_RUN_ID"]
    public string RunId = "";
}
